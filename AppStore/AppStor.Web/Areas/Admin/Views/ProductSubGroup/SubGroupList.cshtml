@using AppStore.Aplication.Utilities
@using AppStore.Domain.ViewModels
@model ProductSubGroupListViewModels

@{
    ViewData["Title"] = " لیست زیرگروهای " + Model.GroupTitel;
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-left">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-area="Admin">خانه</a></li>
                    <li class="breadcrumb-item"><a asp-controller="ProductGroup" asp-action="GroupList" asp-area="Admin">لیست گروها</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
      
            <div class="row d-flex justify-content-start">
            <a asp-action="CreatSubGroup" asp-controller="ProductSubGroup" asp-area="Admin" asp-route-id="@Model.GroupId" class="btn btn-primary d-inline-flex align-items-center">
                    <i class="fa fa-plus"></i><span class="mr-2">افزودن زیرگروه جدید</span>
                </a>
            </div>

    </div><!-- /.container-fluid -->
</section>


<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- /.card-header -->
            <div class="card-body table-responsive p-0">
                <table class="table table-bordered table-hover text-center align-middle">
                    <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>عنوان زیرگروه</th>
                            <th>تاریخ ایجاد</th>
                            <th>تاریخ ویرایش</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SubGroups)
                        {
                            var rowClass = item.IsDelete ? "table-danger" : "";
                            <tr class="@rowClass">
                                <td>@(Model.SubGroups.IndexOf(item) + 1)</td>
                                <td>@item.SubGroupTitel</td>
                                <td>@item.CreatDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.ModifiedDate?.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (item.IsDelete)
                                    {
                                        <span class="badge badge-danger">حذف شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">فعال</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.SubGroupId" class="btn btn-outline-warning btn-sm">
                                            <i class="fa fa-edit"></i> ویرایش
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SubGroupId" class="btn btn-outline-danger btn-sm">
                                            <i class="fa fa-trash"></i> حذف
                                        </a>
                                        <a asp-controller="Product" asp-action="ProductList" asp-route-id="@item.SubGroupId" class="btn btn-outline-info btn-sm">
                                            <i class="fa fa-box"></i> محصولات
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
</div>